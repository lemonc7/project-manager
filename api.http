@HOST = {{$dotenv HOST}}
@TOKEN = {{$dotenv TOKEN}}

### 检查服务器状态
GET {{HOST}}/health HTTP/1.1

### 初始化管理员
POST {{HOST}}/init_admin HTTP/1.1
Content-Type: application/json

{
    "name": "lemonc7",
    "username": "lemonc7",
    "password": "lemonc7"
}

### 登录
POST {{HOST}}/login HTTP/1.1
Content-Type: application/json

{
    "username": "lemonc7",
    "password": "lemonc7"
}

### 更新密码
PUT {{HOST}}/api/password HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
    "oldPassword": "lemonc7",
    "newPassword": "lemonc7"
}

### 重置密码
POST {{HOST}}/api/password/1 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
    "password": "lemonc7"
}

### 查询employees
GET {{HOST}}/api/employee HTTP/1.1
Authorization: Bearer {{TOKEN}}

### 更新employee
PATCH {{HOST}}/api/employee/1 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
    "id": 1,
    "name": "lemonc"
}